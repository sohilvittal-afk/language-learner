# Supabase project settings — from your project's Settings > API page.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Service role (secret) key — bypasses row-level security. Only used server-side
# by the admin user-management endpoints (/api/users). Never expose this to the
# browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional overrides
PORT=4000
SESSION_SECRET=change-this-secret-before-deploying-anywhere-real
