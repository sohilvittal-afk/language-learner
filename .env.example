# Supabase project settings — from your project's Settings > API page.
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role (secret) key — bypasses row-level security. This app has no
# Supabase Auth session to scope requests to (it manages its own accounts in
# the users/profiles tables), so every Supabase query, not just the admin
# panel, runs through this key. Never expose it to the browser or commit a
# real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Moonshot AI (Kimi) API key — powers the Side Quests feature (server.js
# calls Kimi to write each quest's story + comprehension quiz). Get one at
# platform.moonshot.ai. Side Quests are unavailable without it; everything
# else (word bank, flashcard review) works fine if it's unset.
MOONSHOT_API_KEY=your-moonshot-api-key

# Optional Kimi overrides. KIMI_BASE_URL defaults to https://api.moonshot.ai/v1
# (use https://api.moonshot.cn/v1 for the China endpoint); KIMI_MODEL defaults
# to kimi-k2-turbo-preview. KIMI_VISION_MODEL is the image-capable model used
# to read words out of uploaded screenshots/photos on the Word Bank page; it
# defaults to moonshot-v1-8k-vision-preview.
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2-turbo-preview
# KIMI_VISION_MODEL=moonshot-v1-8k-vision-preview

# Optional overrides
PORT=4000
SESSION_SECRET=change-this-secret-before-deploying-anywhere-real
